{
    "name": "corgab/aether",
    "description": "Laravel Quantum Computing bridge for AWS Braket and local simulators",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0",
        "symfony/process": "^7.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0",
        "phpunit/phpunit": "^11.0",
        "pestphp/pest": "*"
    },
    "autoload": {
        "psr-4": {
            "Aether\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Aether\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Aether\\AetherServiceProvider"
            ],
            "aliases": {
                "Quantum": "Aether\\Facades\\Quantum"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
